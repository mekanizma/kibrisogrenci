# =============================================================================
# kibrisogrenci.com — Coolify / local env template
# Copy to .env (never commit real secrets). Coolify: set these in the UI.
# =============================================================================

# --- App ---
NODE_ENV=production
MOCK_MODE=false
NEXT_PUBLIC_SITE_URL=https://kibrisogrenci.com
# Comma-separated browser origins allowed for CORS (optional; same-origin is enough)
CORS_ORIGINS=https://kibrisogrenci.com

# --- Supabase (Coolify self-hosted OR cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://supabase.YOUR_DOMAIN
# Publishable / anon key (safe in browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# Service-role / secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=eyJhbGciOi...
# Optional direct DB URL for worker / migrations
# SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db:5432/postgres

# Hash salt for IP / UA (reveal + reports). Generate: openssl rand -hex 32
IP_HASH_SECRET=replace-with-long-random-hex

# --- Auth redirects (Supabase Auth → URL Configuration) ---
# Site URL: https://kibrisogrenci.com
# Redirect: https://kibrisogrenci.com/**

# --- Billing (offline bank transfer) ---
BANK_NAME=Kıbrıs Vakıflar Bankası
BANK_IBAN=TR00 0000 0000 0000 0000 0000 00

# --- WhatsApp Cloud API (optional) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ALLOW_WHATSAPP_SIM=false

# --- Optional hero override ---
# NEXT_PUBLIC_HERO_IMAGE=/hero.jpg

# --- Dev-only (never enable in Coolify prod) ---
# MOCK_MODE=true
# MOCK_ALLOW_DEMO_AUTH=true
