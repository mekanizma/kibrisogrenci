# =============================================================================
# kibrisogrenci.com — Coolify / production env template
# Copy to Coolify (or .env.local) and fill real values. Do not commit secrets.
# Supabase Dashboard → Project Settings → API for keys.
# =============================================================================

NODE_ENV=production
# Live data only — never set MOCK_MODE=true in production
MOCK_MODE=false
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false
MOCK_ALLOW_DEMO_AUTH=false
NEXT_PUBLIC_SHOW_WHATSAPP_DEMO=false
NEXT_PUBLIC_SITE_URL=https://kibrisogrenci.com
CORS_ORIGINS=https://kibrisogrenci.com

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (login / signup / password reset CAPTCHA)
# 1) Create widget: https://dash.cloudflare.com/?to=/:account/turnstile
# 2) Paste Site Key below; paste Secret Key in Supabase:
#    Auth → Attack Protection → Enable CAPTCHA → Cloudflare Turnstile
# Test keys (always pass): site 1x00000000000000000000AA
#                          secret 1x0000000000000000000000000000000AA
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Paste service_role from Supabase Dashboard → Project Settings → API
# NEVER commit the real secret. NEVER expose it to the browser.
SUPABASE_SECRET_KEY=

# Generate with: openssl rand -hex 32  (unique per environment; do not reuse examples)
IP_HASH_SECRET=

BANK_NAME=Kıbrıs Vakıflar Bankası
BANK_IBAN=

# -----------------------------------------------------------------------------
# Shopier PAT (premium listing payments)
# Panel: https://www.shopier.com → Hesap Yönetimi → Kişisel Erişim Anahtarı
# Shop slug: mağaza URL’sindeki ad (ör. shopier.com/mekanizmabt → mekanizmabt)
# Webhook: POST /v1/webhooks { event: "order.created", url: ".../api/payments/shopier/webhook" }
#          dönen "token" değerini aşağıya yazın
# -----------------------------------------------------------------------------
SHOPIER_PAT=
SHOPIER_SHOP_SLUG=
SHOPIER_WEBHOOK_TOKEN=
# Public HTTPS image Shopier can fetch & rehost (avoid Cloudflare-protected site URLs)
# Default: {NEXT_PUBLIC_SUPABASE_URL}/storage/v1/object/public/public-assets/shopier/product.jpg
SHOPIER_PRODUCT_IMAGE_URL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# System notification emails (app → SMTP)
# Supabase Auth already uses its own SMTP for signup/reset; duplicate the same
# credentials here so the Next.js app can send message/listing notifications.
# Host: smtp.mnic.tr · Port 587 · STARTTLS
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.mnic.tr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kıbrıs Öğrenci <noreply@kibrisogrenci.com>"

